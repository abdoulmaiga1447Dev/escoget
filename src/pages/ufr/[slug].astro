---
/** Page d'une UFR : présentation et formations rattachées. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntetePage from '../../components/EntetePage.astro';
import CarteFormation from '../../components/CarteFormation.astro';
import { etablissement } from '../../data/etablissement';
import { formations, niveaux, domaines, ordreDomaines, type Domaine, type Niveau } from '../../data/formations';

export function getStaticPaths() {
  return ordreDomaines.map((domaine) => ({ params: { slug: domaines[domaine].slug }, props: { domaine } }));
}

const { domaine } = Astro.props as { domaine: Domaine };
const ufr = etablissement.ufr.find((u) => u.domaine === domaine)!;
const nom = domaines[domaine].ufr;
const liste = formations.filter((f) => f.domaine === domaine);
const ordre: Niveau[] = ['BTS', 'Licence', 'Master'];
---

<BaseLayout titre={nom} description={`${nom}, Université ESCOGET : ${ufr.texte}`}>
  <EntetePage
    titre={nom}
    surtitre="UFR"
    intro={ufr.texte}
    ariane={[{ libelle: 'UFR', lien: '/ufr' }, { libelle: domaines[domaine].libelle }]}
    image={ufr.image}
  />

  <section class="section">
    <div class="conteneur presentation">
      {
        ufr.pointsForts.length > 0 ? (
          <ul class="points">
            {ufr.pointsForts.map((p) => (
              <li data-revele>{p}</li>
            ))}
          </ul>
        ) : (
          <p class="resume" data-revele>
            {liste.length} formations, de la Licence au Master, pour se préparer aux métiers du droit, de l’administration et de la fiscalité.
          </p>
        )
      }
      <aside class="contact" data-revele>
        <p><strong>Une question sur les formations de l’UFR ?</strong></p>
        <p>Notre service de scolarité vous répond et vous oriente.</p>
        <a class="bouton bouton-secondaire" href="/contact">Nous contacter</a>
      </aside>
    </div>
  </section>

  <section class="section section-douce">
    <div class="conteneur">
      <div class="entete-section" data-revele>
        <h2>{liste.length} formations</h2>
      </div>
      {
        ordre.map((n) => {
          const duNiveau = liste.filter((f) => f.niveau === n);
          return duNiveau.length ? (
            <div class="groupe">
              <h3 class="groupe-titre">
                {niveaux[n].libelle} <span>{niveaux[n].duree}</span>
              </h3>
              <ul class="grille">
                {duNiveau.map((f) => (
                  <li data-revele>
                    <CarteFormation formation={f} />
                  </li>
                ))}
              </ul>
            </div>
          ) : null;
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .presentation {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: var(--e-6);
    align-items: start;
  }

  .points {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    padding: var(--e-3) 0;
    border-bottom: 1px solid var(--filet);
    font-size: var(--taille-l);
    font-weight: 600;
    color: var(--bleu);
  }

  .resume {
    font-size: var(--taille-l);
    font-weight: 600;
    color: var(--bleu);
    max-width: 40rem;
  }

  .contact {
    display: grid;
    gap: var(--e-2);
    justify-items: start;
    padding: var(--e-4);
    border-radius: var(--rayon);
    background: var(--fond-doux);
    border-top: 4px solid var(--rouge);
    color: var(--encre-douce);
  }

  .contact strong {
    color: var(--bleu);
    font-size: var(--taille-l);
  }

  .groupe + .groupe {
    margin-top: var(--e-5);
  }

  .groupe-titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: var(--e-2);
    margin-bottom: var(--e-3);
    border-bottom: 2px solid var(--bleu);
    font-size: var(--taille-xl);
  }

  .groupe-titre span {
    font-size: var(--taille-s);
    font-weight: 500;
    color: var(--encre-douce);
  }

  .grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 960px) {
    .presentation {
      grid-template-columns: 1fr;
      gap: var(--e-4);
    }

    .grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .grille {
      grid-template-columns: 1fr;
    }
  }
</style>
